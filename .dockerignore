# Build-context hygiene (TECH-DEBT P1): the app Dockerfiles COPY from the
# repo root context — keep .git, bytecode, caches and local secrets out of
# the context sent to the Docker daemon.
.git
.gitconfig
**/__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
# docs/ is excluded EXCEPT docs/ontology — the mock image COPYs the SHACL
# shapes (mock_fen_api/scaffold.py validates against them at runtime).
docs/*
!docs/ontology/
!docs/ontology/*
examples/
tests/
.vendor/
*.md
!README.md
