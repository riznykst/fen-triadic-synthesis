# ---- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Logging / observability ---------------------------------------------
# DEBUG | INFO | WARNING | ERROR — JSON-structured stdout logs, see
# services/common/logging_config.py
LOG_LEVEL=INFO

# ---- FEN Bridge ----------------------------------------------------------
# Topic names are env-configurable; the FEN_TOPIC_* aliases match the
# names expected from the real DAP (to be confirmed with the consortium):
#   FEN_TOPIC_CANDIDATES=dap.entities.extracted.v1
#   FEN_TOPIC_VALIDATED=dap.entities.validated.v1
TOPIC_PENDING_VALIDATION=dap.entities.pending_validation.v1
TOPIC_GOVERNANCE_DECISIONS=fen.governance.decisions.v1
TOPIC_VALIDATED=dap.entities.validated.v1
FEN_API_BASE_URL=http://localhost:8100
FEN_BRIDGE_GROUP_ID=fen-bridge-outbound
FEN_BRIDGE_BATCH_SIZE=10
FEN_BRIDGE_POLL_TIMEOUT_MS=1000

# ---- RDF store -----------------------------------------------------------
SPARQL_UPDATE_USER=
SPARQL_UPDATE_PASSWORD=
SPARQL_UPDATE_ENDPOINT=http://localhost:3030/fen/update
SPARQL_QUERY_ENDPOINT=http://localhost:3030/fen/query
SPARQL_PING_ENDPOINT=http://localhost:3030/$/ping

# ---- Mock FEN API (demo only, see ADR-002) -------------------------------
FEN_BRIDGE_WEBHOOK_URL=http://localhost:8101/webhook/decision
MOCK_FEN_DECISION_DELAY_S=3
MOCK_FEN_MAX_WORKERS=8
MOCK_FEN_WEBHOOK_RETRIES=3

# ---- PIDs (ADR-003) ------------------------------------------------------
FEN_NAAN=99999

# ---- Webhook auth (MUST be set for any non-local deployment) ------------
FEN_WEBHOOK_TOKEN=

# ---- Pluggable LLM judge (OpenAI-compatible; optional, demo) -------------
# Any OpenAI-compatible endpoint works for tests: OpenAI, DeepSeek, local
# vLLM/Ollama, or GRAPHIA services (LLM4SSH/Quagga) exposing such an API.
FEN_LLM_BASE_URL=
FEN_LLM_API_KEY=
FEN_LLM_MODEL=deepseek-chat
FEN_LLM_TIMEOUT_S=30

# ---- Web interface layer ------------------------------------------------
# FEN_WEB_DIR: directory (inside the status-api image) served at /web
FEN_WEB_DIR=web
FEN_CORS_ORIGINS=*
FEN_MOCK_VOTING=auto          # auto | community | qv (QV: intensity votes, ADR-005 threshold)
FEN_MOCK_QUORUM=3          # classic count quorum (community mode)
FEN_MOCK_QV_THRESHOLD=10   # QV weighted-score threshold (qv mode)

# ---- Prometheus metrics (consumer processes) ------------------------------
# fen-bridge-outbound listens on 9101, validation-consumer on 9102 by
# default — override here if those ports are taken (services/common/metrics.py).
METRICS_PORT=

# ---- Virtuoso dialect check (optional; scripts/virtuoso_dialect_check.py) --
VIRTUOSO_ENDPOINT=http://localhost:8890
VIRTUOSO_USER=dba
VIRTUOSO_PASSWORD=dba
